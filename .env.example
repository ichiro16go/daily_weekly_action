JIRA_BASE_URL=https://epark-tech.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
WEEKLY_LABEL=運用保守
# 起動時に Jira から取得し、この正規表現にマッチするラベルを weekly_labels に自動追加する。
# 既定: "運用保守" + 6桁数字 (運用保守202401 など月次タグを全部拾う)。
# 空文字で自動展開を無効化。
# WEEKLY_LABEL_PATTERN=^運用保守\d{6}$
# 対象プロジェクト（カンマ区切り、省略時はデフォルト5プロジェクトを使用）
# JIRA_PROJECTS=JPREQ,EPGQC,JUSTPASS,FASPACLOUD,GRMREQ
# 集計から除外するプロジェクトキー（カンマ区切り、既定: SYOUGYO）
# アサイン者ホワイトリストに該当しても、このリストにあるプロジェクトのチケットは除外する
# EXCLUDED_PROJECTS=SYOUGYO

# サブタスクをダッシュボード集計に含めるか（既定: true）
# false にすると issuetype=Sub-task / サブタスク を除外
# INCLUDE_SUBTASKS=true

# カレンダーで使う Jira 開始日(WBSGantt) カスタムフィールド ID（既定: customfield_10200）
# 空にすると startDate を取得せず、created を開始日にフォールバックする
# JIRA_START_DATE_FIELD=customfield_10200

# カレンダーで使う Jira 終了日(WBSGantt) カスタムフィールド ID（既定: customfield_10201）
# 空にすると dueDate は Jira 期限(duedate) のみを参照する
# JIRA_END_DATE_FIELD=customfield_10201
